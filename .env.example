ALLOWED_ORIGINS=https://ets-petit.fr,https://www.etspetit.fr

# Administration privée des tarifs.
ADMIN_EMAIL=contact@ets-petit.fr
# Format hexadécimal "sel:empreinte" généré avec scrypt. Ne jamais mettre le mot de passe en clair.
ADMIN_PASSWORD_HASH=replace-with-a-scrypt-hash
# Secret aléatoire d'au moins 32 octets utilisé pour protéger les sessions.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Serveur SMTP utilisé pour transmettre les demandes du formulaire.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@ets-petit.fr
SMTP_PASSWORD=change-me

# CONTACT_FROM doit généralement correspondre au compte SMTP.
CONTACT_FROM=Site ETS PETIT <contact@ets-petit.fr>
CONTACT_TO=etspetitelec@gmail.com
